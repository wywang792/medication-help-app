{
  "bsonType": "object",
  "required": ["title", "status"],
  "permission": {
    "read": true,
    "create": "auth.uid != null",
    "update": "auth.uid != null",
    "delete": "auth.uid != null"
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "title": {
      "bsonType": "string",
      "description": "文章标题",
      "title": "文章标题"
    },
    "description": {
      "bsonType": "string",
      "description": "文章描述",
      "title": "文章描述"
    },
    "cover_image": {
      "bsonType": "string",
      "description": "封面图片",
      "title": "封面图片"
    },
    "paragraphs": {
      "bsonType": "array",
      "description": "文章段落",
      "title": "文章段落",
      "items": {
        "bsonType": "object",
        "properties": {
          "title": {
            "bsonType": "string",
            "description": "段落标题"
          },
          "content": {
            "bsonType": "string",
            "description": "段落内容"
          },
          "sort_order": {
            "bsonType": "int",
            "description": "段落排序"
          }
        }
      }
    },
    "status": {
      "bsonType": "string",
      "enum": ["enabled", "disabled"],
      "description": "状态：enabled-启用，disabled-禁用",
      "title": "状态"
    },
    "sort_order": {
      "bsonType": "int",
      "description": "排序顺序",
      "title": "排序顺序"
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "title": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "title": "更新时间"
    }
  }
}
